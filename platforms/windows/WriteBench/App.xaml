<Application x:Class="WriteBench.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17233C"/><SolidColorBrush x:Key="Muted" Color="#73819B"/><SolidColorBrush x:Key="Blue" Color="#3266F5"/>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="#F4F7FC"/></Style>
  <Style TargetType="Button"><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{StaticResource Blue}"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3EAF5"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Plate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="16"/><Setter Property="BorderBrush" Value="#E3EAF5"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="SelectionBrush" Value="#AFC8FF"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,0,12,0"/></Style>
 </Application.Resources>
</Application>
